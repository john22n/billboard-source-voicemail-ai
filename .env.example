OPENAI_API_KEY=
OPENAI_EMBEDDING_API_KEY=

# VPS deployment (hostname only, without https:// or a trailing slash)
PUBLIC_HOST=
ENVIRONMENT=production

# OpenTelemetry/Jaeger. Docker Compose overrides the endpoint to the Jaeger service.
ENABLE_TRACING=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=voicemail-agent
OTEL_CONSOLE_EXPORT=false

DATABASE_URL=
NEON_API_KEY=
NEON_PROJECT_ID=

NUTSHELL_EMAIL=
NUTSHELL_API_KEY=
NUTSHELL_LEAD_SUBMISSION_ENABLED=false

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
